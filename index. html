<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TKIET, Warananagar | Examination Management System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f5f7fb;
    color:#1e293b;
}

/* TOP BAR */
.topbar{
    background:#092c55;
    color:white;
    padding:8px 6%;
    display:flex;
    justify-content:space-between;
    font-size:13px;
}

/* HEADER */
.header{
    background:white;
    padding:18px 6%;
    display:flex;
    align-items:center;
    gap:16px;
    border-bottom:1px solid #e5e7eb;
}

.logo{
    width:65px;
    height:65px;
    border-radius:50%;
    background:#0b5cab;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
    font-size:17px;
    box-shadow:0 3px 10px #0002;
}

.header h1{
    color:#092c55;
    font-size:24px;
}

.header p{
    color:#64748b;
    margin-top:5px;
    font-size:14px;
}

/* NAVIGATION */
.nav{
    background:#0b5cab;
    padding:0 6%;
    display:flex;
    align-items:center;
    min-height:52px;
}

.nav a{
}

/* CONTACT */
.contact-box{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.contact-item{
    background:white;
    padding:25px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 4px 15px #0000000d;
}

.contact-item h3{
    color:#092c55;
    margin-bottom:8px;
}

/* FOOTER */
.footer{
    background:#071f3c;
    color:white;
    padding:35px 6%;
    margin-top:50px;
}

.footer-grid{
    display:grid;
    grid-template-columns:2fr 1fr 1fr;
    gap:30px;
}

.footer h3{
    margin-bottom:12px;
}

.footer p,
.footer a{
    color:#cbd5e1;
    font-size:14px;
    line-height:1.8;
}

.footer a{
    text-decoration:none;
    display:block;
}

.copyright{
    border-top:1px solid #ffffff22;
    margin-top:25px;
    padding-top:18px;
    text-align:center;
    font-size:13px;
    color:#94a3b8;
}

/* LOGIN MODAL */
.modal{
    display:none;
    position:fixed;
    z-index:1000;
    inset:0;
    background:#00000088;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.login-box{
    background:white;
    width:100%;
    max-width:400px;
    padding:30px;
    border-radius:12px;
    position:relative;
}

.login-box h2{
    color:#092c55;
    margin-bottom:20px;
}

.login-box input{
    width:100%;
    padding:13px;
    margin-bottom:12px;
    border:1px solid #ccd5e1;
    border-radius:6px;
}

.login-box button{
    width:100%;
    padding:13px;
    background:#0b5cab;
    color:white;
    border:0;
    border-radius:6px;
    font-weight:bold;
}

.close{
    position:absolute;
    right:20px;
    top:15px;
    font-size:25px;
    cursor:pointer;
}

